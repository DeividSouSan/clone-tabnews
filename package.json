{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently --names next,jest --hide next --kill-others --success command-jest \"next dev\" \"jest --runInBand --verbose\" ",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose --file infra/compose.yaml up -d",
    "services:down": "docker compose --file infra/compose.yaml down",
    "services:stop": "docker compose --file infra/compose.yaml stop",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m ./infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "commitizen": "4.3.2",
    "cookie": "2.0.0",
    "dedent": "1.7.2",
    "next": "16.2.9",
    "next-connect": "1.0.0",
    "node-pg-migrate": "6.2.2",
    "nodemailer": "9.0.1",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.4.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@commitlint/cli": "21.1.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "@commitlint/config-conventional": "21.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "concurrently": "10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.3",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.0.8",
    "prettier": "3.9.1",
    "prettier-eslint": "17.1.1",
    "secretlint": "13.0.2",
    "set-cookie-parser": "3.1.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ]
  },
  "engines": {
    "node": "24"
  }
}
